# Бұл файлды .env деп көшіріңіз. Барлық жолдар міндетті емес.

# ---- ЖИ жеткізушісі ----
# anthropic — Claude (API кілті керек, https://console.anthropic.com)
# ollama    — модель осы компьютерде жұмыс істейді, кілт керек емес (https://ollama.com)
# Көрсетілмесе: ANTHROPIC_API_KEY болса — anthropic, болмаса — ollama.
# PROVIDER=ollama

# Claude үшін:
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-sonnet-5-5

# Ollama үшін (алдымен: ollama pull gemma3:12b):
# OLLAMA_MODEL=gemma3:12b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192

# ---- Тіркелгілер мен база ----
# Тіркелу кодын орнатсаңыз, тек коды бар мұғалімдер тіркеле алады
# REGISTRATION_CODE=
# Жаңа тіркелуді толық өшіру: ALLOW_REGISTRATION=0
# Деректер базасы (SQLite):
# DB_PATH=data/app.db
# HTTPS арқылы жариялағанда:
# COOKIE_SECURE=1

# ---- Басқа ----
# PORT=3000
# APP_NAME=Педагог көмекшісі
# RATE_LIMIT=30
